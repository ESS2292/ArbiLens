APP_NAME=ArbiLens API
APP_ENV=development
APP_DEBUG=false
API_V1_PREFIX=/api/v1
LOG_LEVEL=INFO
JWT_SECRET_KEY=development-secret-key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
MAX_UPLOAD_SIZE_BYTES=26214400
APP_BASE_URL=http://localhost:3000

DATABASE_URL=postgresql+psycopg://postgres:postgres@postgres:5432/arbilens
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

S3_ENDPOINT_URL=http://s3:9090
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=arbilens-documents
S3_REGION=us-east-1

# Leave the key empty to keep AI calls unconfigured. The offline CLI does not read this file.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_TIMEOUT_SECONDS=30
OPENAI_MAX_RETRIES=3
OPENAI_TEMPERATURE=0

STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
